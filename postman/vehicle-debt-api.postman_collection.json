      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('returns HTTP 400', () => pm.response.to.have.status(400));", "pm.test('error identifies invalid plate', () => pm.expect(pm.response.json().error.code).to.eql('invalid_plate'));" ]}}]
