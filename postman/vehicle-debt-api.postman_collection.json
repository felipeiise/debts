      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('returns HTTP 422', () => pm.response.to.have.status(422));", "pm.test('error identifies unknown debt type', () => pm.expect(pm.response.json().error.code).to.eql('unknown_debt_type'));" ]}}]
