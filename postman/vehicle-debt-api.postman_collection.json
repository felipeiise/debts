      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('returns HTTP 400', () => pm.response.to.have.status(400));", "pm.test('error identifies required JSON content type', () => pm.expect(pm.response.json().error.code).to.eql('content_type_required'));" ]}}]
    },
