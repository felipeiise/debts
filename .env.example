APP_NAME="Vehicle Debt API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr
LOG_LEVEL=info
PROVIDER_A_URL=http://provider-a.test/debts
PROVIDER_B_URL=http://provider-b.test/debts
PROVIDER_TIMEOUT_SECONDS=3
MAX_REQUEST_BYTES=16384
# Fixed UTC reference date for local API/Postman testing; leave unset in production.
VEHICLE_DEBTS_AS_OF=2024-05-10T00:00:00Z
# Redis connection for Laravel running on the host; Compose overrides REDIS_HOST to redis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=30
CIRCUIT_BREAKER_OPEN_SECONDS=30
CIRCUIT_BREAKER_PROBE_LEASE_SECONDS=15
